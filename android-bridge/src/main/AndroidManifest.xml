<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="com.flyme.auto.gencards.permission.SUBMIT_QUERY" />

    <queries>
        <package android:name="com.flyme.auto.gencards" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="GenSimulator Bridge"
        android:supportsRtl="true">
        <activity
            android:name=".BridgeBootstrapActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
        <service
            android:name=".BridgeRuntimeService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB-controlled local HTTP bridge for development integration tests" />
        </service>
    </application>
</manifest>
